{
	on_demand_tls {
		ask {$ASK_ENDPOINT:http://super-backend.railway.internal:5000/api/v1/caddy/check-domain}
	}
}

# -------------------------------------------------------------
# 1. Custom Tenant Domains (Port 443 via Railway TCP Proxy)
# -------------------------------------------------------------
https:// {
	tls {
		on_demand
	}

	respond /health 200 {
		body "ok"
	}

	reverse_proxy {$UPSTREAM_URL:http://web.railway.internal:3000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}
}

# -------------------------------------------------------------
# 2. Wildcard Subdomains & Railway Edge HTTP (Port :{$PORT})
# -------------------------------------------------------------
:{$PORT:8080} {
	respond /health 200 {
		body "ok"
	}

	reverse_proxy {$UPSTREAM_URL:http://web.railway.internal:3000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
