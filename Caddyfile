# Production and pre-production share this edge; keep their upstreams and cache entries isolated.
{
	# Loopback only; the private :9000 listener forwards /__cache/* here with Host localhost:2019.
	admin localhost:2019 {
		origins localhost:2019 127.0.0.1:2019
	}
	order request_header before cache
	order cache before rewrite
	order rate_limit before basicauth

	storage redis {
		address "{$REDIS_HOST}"
		password "{$REDIS_PASSWORD}"
		key_prefix "caddy:tls"
	}

	cache {
		# Do not reuse entries created before cookie/response/Vary safety guards.
		key {
			template "edge-safe-v1-{http.request.method}-{http.request.scheme}-{http.request.host}{http.request.uri}"
		}
		redis {
			url {$REDIS_URL}
		}
		regex {
			exclude ".*(/api/|/auth/|/account/|/checkout/|/health).*"
		}
		api {
			basepath /__cache
			souin
		}
		ttl 7200s
		stale 86400s
	}

	on_demand_tls {
		ask {$ASK_ENDPOINT:https://dhimora-backend.fly.dev/v2/store/lookup}
	}
}

# Internal purge-only listener on port 9000 (not in fly.toml [[services]] = private network only)
:9000 {
	handle /__cache/* {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host localhost:2019
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -Sec-Fetch-Mode
			header_up -Origin
		}
	}
	respond 404
}

# Port 80 is public in fly.toml. Cache administration is private-port-only.
http:// {
	@externalCacheApi path /__cache*
	respond @externalCacheApi 403

	@notHealthOrPurge {
		not path /health
		not path /__cache*
	}
	redir @notHealthOrPurge https://{host}{uri} permanent

	header {
		-Via
		Server "Dhimora-Edge-Shield"
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}
}

# HTTPS: On-Demand TLS for custom tenant domains and wildcard subdomains
https:// {
	tls {
		on_demand
	}

	# Strip incoming browser cache-busting headers (DevTools disable cache / Ctrl+F5)
	request_header -Cache-Control
	request_header -Pragma

	# One JSON access line per request; Caddy redacts Cookie, Set-Cookie and Authorization by default.
	log {
		output stdout
		format json
	}
	log_skip /health

	# Block external access to cache administrative endpoints
	# Fly's gateway may have a private source IP even for public requests.
	@externalCacheApi path /__cache*
	respond @externalCacheApi 403

	# Matcher: Only apply to page requests (excluding static assets, media, Next.js chunks, fonts, and health checks)
	@rateLimitedPages {
		not path /_next/* /images/* /assets/* /fonts/* /static/* /robots.txt /sitemap.xml /__cache*
		not path *.js *.css *.png *.jpg *.jpeg *.svg *.webp *.gif *.ico *.woff *.woff2 *.ttf *.eot *.map *.json
	}

	# Rate limiting: 1080 page requests per minute per IP (3x increased from 360)
	rate_limit @rateLimitedPages {
		zone store_page_zone {
			key {remote_host}
			events 1080
			window 1m
		}
	}

	header {
		-Via
		-Surrogate-Key
		X-Powered-By "Dhimora Echo"
	}
	# Also protect downstream browser/CDN caches when the origin labels a personalized page public.
	@withCookie header Cookie *
	header @withCookie >Cache-Control "private, no-store"
	@withAuthorization header Authorization *
	header @withAuthorization >Cache-Control "private, no-store"

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	# Cookie and Authorization requests bypass shared storage. Unknown cookies bypass too so new personalization
	# remains private without creating per-cookie cache keys.
	@anonymous {
		header !Cookie
		header !Authorization
		method GET HEAD
		not path /api /api/* /auth /auth/* /account /account/* /checkout /checkout/* /health /__cache*
	}
	cache @anonymous

	# Pre-production edge routing for *.test.dhimora.com
	@preprod host *.test.dhimora.com
	reverse_proxy @preprod {$PREPROD_UPSTREAM_URL:https://dhimora-echo-ecommerce-test.fly.dev} {
		header_up Host {$PREPROD_UPSTREAM_HOST:dhimora-echo-ecommerce-test.fly.dev}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		# Keep Next's representation and locale Vary tokens; only remove internal proxy host tokens already covered by
		# Caddy's host-specific cache key.
		header_down Vary "(?i)(^|, *)host( *, *|$)" "$1"
		header_down Vary "(?i)(^|, *)x-forwarded-host( *, *|$)" "$1"
		header_down Vary "(?i)(^|, *)x-tenant-domain( *, *|$)" "$1"
		header_down Vary ", *$" ""
		header_down -Via
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01-test"

		@notOK status 201 202 203 204 205 206 207 208 226 3xx 4xx 5xx
		handle_response @notOK {
			header >Cache-Control "no-store"
			copy_response
		}

		@setCookie header Set-Cookie *
		handle_response @setCookie {
			header >Cache-Control "private, no-store"
			copy_response
		}
	}

	# Production edge routing default
	reverse_proxy {$UPSTREAM_URL:https://dhimora-echo-ecommerce.fly.dev} {
		header_up Host {$UPSTREAM_HOST:dhimora-echo-ecommerce.fly.dev}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		# Keep Next's representation and locale Vary tokens; only remove internal proxy host tokens already covered by
		# Caddy's host-specific cache key.
		header_down Vary "(?i)(^|, *)host( *, *|$)" "$1"
		header_down Vary "(?i)(^|, *)x-forwarded-host( *, *|$)" "$1"
		header_down Vary "(?i)(^|, *)x-tenant-domain( *, *|$)" "$1"
		header_down Vary ", *$" ""
		header_down -Via
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01"

		@notOK status 201 202 203 204 205 206 207 208 226 3xx 4xx 5xx
		handle_response @notOK {
			header >Cache-Control "no-store"
			copy_response
		}

		@setCookie header Set-Cookie *
		handle_response @setCookie {
			header >Cache-Control "private, no-store"
			copy_response
		}
	}
}
