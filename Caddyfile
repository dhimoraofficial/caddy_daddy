{
	on_demand_tls {
		ask {$ASK_ENDPOINT:https://dhimora-backend-production.up.railway.app/v1/store/lookup}
	}
}

# HTTP: Health check and automatic redirect to HTTPS
http:// {
	@notHealth not path /health
	redir @notHealth https://{host}{uri} permanent

	respond /health 200 {
		body "ok"
	}
}

# HTTPS: On-Demand TLS for custom tenant domains and wildcard subdomains
https:// {
	tls {
		on_demand
	}

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	reverse_proxy {$UPSTREAM_URL:https://production-storefront-production.up.railway.app} {
		header_up Host {$UPSTREAM_HOST:production-storefront-production.up.railway.app}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}
