# Note be sure where you are editing on rpoduciton or preproduciton two are diffrent things choose wisely,
{
	admin 0.0.0.0:2019 {
		origins localhost:2019 127.0.0.1:2019 caddy-daddy.internal:9000 caddy-daddy.internal:2019
	}
	debug
	order request_header before cache
	order cache before rewrite
	order rate_limit before basicauth

	storage redis {
		address "{$REDIS_HOST}"
		password "{$REDIS_PASSWORD}"
		key_prefix "caddy:tls"
	}

	cache {
		redis {
			url {$REDIS_URL}
		}
		regex {
			exclude ".*(/api/|/auth/|/account/|/checkout/|/health).*"
		}
		api {
			basepath /__cache
			souin
		}
		ttl 7200s
		stale 86400s
	}

	on_demand_tls {
		ask {$ASK_ENDPOINT:https://dhimora-backend.fly.dev/v2/store/lookup}
	}
}

# Internal purge-only listener on port 9000 (not in fly.toml [[services]] = private network only)
:9000 {
	handle {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host localhost:2019
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -Sec-Fetch-Mode
			header_up -Origin
		}
	}
}

# HTTP: Health check, internal purge API, and automatic redirect to HTTPS
http:// {
	@internalPurge {
		path /__cache*
	}

	handle @internalPurge {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host localhost:2019
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -Sec-Fetch-Mode
			header_up -Origin
		}
	}

	@notHealthOrPurge {
		not path /health
		not path /__cache*
	}
	redir @notHealthOrPurge https://{host}{uri} permanent

	header {
		-Via
		Server "Dhimora-Edge-Shield"
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}

	cache
}

# HTTPS: On-Demand TLS for custom tenant domains and wildcard subdomains
https:// {
	tls {
		on_demand
	}

	# Strip incoming browser cache-busting headers (DevTools disable cache / Ctrl+F5)
	request_header -Cache-Control
	request_header -Pragma

	# Block external access to cache administrative endpoints
	@externalCacheApi {
		path /__cache*
		not remote_ip 127.0.0.1 ::1 fd00::/8 172.16.0.0/12
	}
	respond @externalCacheApi 403

	# Matcher: Only apply to page requests (excluding static assets, media, Next.js chunks, fonts, and health checks)
	@rateLimitedPages {
		not path /_next/* /images/* /assets/* /fonts/* /static/* /robots.txt /sitemap.xml /__cache*
		not path *.js *.css *.png *.jpg *.jpeg *.svg *.webp *.gif *.ico *.woff *.woff2 *.ttf *.eot *.map *.json
	}

	# Rate limiting: 360 page requests per minute per IP (3x increased from 120)
	rate_limit @rateLimitedPages {
		zone store_page_zone {
			key {remote_host}
			events 360
			window 1m
		}
	}

	header {
		-Via
		-Surrogate-Key
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	cache

	# Pre-production edge routing for *.test.dhimora.com
	@preprod host *.test.dhimora.com
	reverse_proxy @preprod https://dhimora-echo-ecommerce-test.fly.dev {
		header_up Host dhimora-echo-ecommerce-test.fly.dev
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		header_down Vary "rsc, Accept-Encoding"
		header_down -Via
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01-test"
	}

	# Production edge routing default
	reverse_proxy {$UPSTREAM_URL:https://dhimora-echo-ecommerce.fly.dev} {
		header_up Host {$UPSTREAM_HOST:dhimora-echo-ecommerce.fly.dev}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		header_down Vary "rsc, Accept-Encoding"
		header_down -Via
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01"
	}
}
