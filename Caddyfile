# Note be sure where you are editing on rpoduciton or preproduciton two are diffrent things choose wisely,
{
	admin 0.0.0.0:2019 {
		origins caddy-daddy.internal:2019 localhost:2019
	}
	debug
	order cache before rewrite
	order rate_limit before basicauth

	cache {
		badger {
			path /data/cache
		}
		regex {
			exclude ".*(/api/|/auth/|/account/|/checkout/|/health).*"
		}
		api {
			basepath /__cache
			souin
		}
		ttl 7200s
		stale 86400s
	}

	on_demand_tls {
		ask {$ASK_ENDPOINT:https://dhimora-backend.fly.dev/v2/store/lookup}
	}
}

# HTTP: Health check, internal purge API, and automatic redirect to HTTPS
http:// {
	@internalPurge {
		path /__cache*
		remote_ip 127.0.0.1 ::1 fd00::/8 172.16.0.0/12
	}

	handle @internalPurge {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host localhost:2019
		}
	}

	@notHealthOrPurge {
		not path /health
		not path /__cache*
	}
	redir @notHealthOrPurge https://{host}{uri} permanent

	header {
		-Via
		Server "Dhimora-Edge-Shield"
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}

	cache
}

# HTTPS: On-Demand TLS for custom tenant domains and wildcard subdomains
https:// {
	tls {
		on_demand
	}

	# Block external access to cache administrative endpoints
	@externalCacheApi {
		path /__cache*
		not remote_ip 127.0.0.1 ::1 fd00::/8 172.16.0.0/12
	}
	respond @externalCacheApi 403

	# Rate limiting: 120 requests per minute per IP
	rate_limit {
		zone store_client_zone {
			key {remote_host}
			events 3
			window 1s
		}
	}

	header {
		-Via
		-Surrogate-Key
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	cache

	# Pre-production edge routing for *.test.dhimora.com
	@preprod host *.test.dhimora.com
	reverse_proxy @preprod https://dhimora-echo-ecommerce-test.fly.dev {
		header_up Host dhimora-echo-ecommerce-test.fly.dev
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		header_down Vary "rsc, Accept-Encoding, Host, X-Forwarded-Host, X-Tenant-Domain"
		header_down -Via
		header_down -Surrogate-Key
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01-test"
	}

	# Production edge routing default
	reverse_proxy {$UPSTREAM_URL:https://dhimora-echo-ecommerce.fly.dev} {
		header_up Host {$UPSTREAM_HOST:dhimora-echo-ecommerce.fly.dev}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		header_down +Vary "Host, X-Forwarded-Host, X-Tenant-Domain"
		header_down -Via
		header_down -Surrogate-Key
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01"
	}
}
