{
	on_demand_tls {
		ask {$ASK_ENDPOINT:http://dhimora-backend.railway.internal:2000/v1/store/lookup}
	}
}

# -------------------------------------------------------------
# 1. Custom Tenant Domains (Port 443 via Railway TCP Proxy)
# -------------------------------------------------------------
https:// {
	tls {
		on_demand
	}

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	reverse_proxy {$UPSTREAM_URL:http://template-based-rendering.railway.internal:3000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}
}

# -------------------------------------------------------------
# 2. Wildcard Subdomains & Railway Edge HTTP (Port :{$PORT})
# -------------------------------------------------------------
:{$PORT:8080} {
	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	reverse_proxy {$UPSTREAM_URL:http://template-based-rendering.railway.internal:3000} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
	}
}
