{
	debug
	on_demand_tls {
		ask {$ASK_ENDPOINT:https://dhimora-backend.fly.dev/v2/store/lookup}
	}
}

# HTTP: Health check and automatic redirect to HTTPS
http:// {
	@notHealth not path /health
	redir @notHealth https://{host}{uri} permanent

	header {
		-Via
		Server "Dhimora-Edge-Shield"
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}
}

# HTTPS: On-Demand TLS for custom tenant domains and wildcard subdomains
https:// {
	tls {
		on_demand
	}

	header {
		-Via
		Server "Dhimora-Edge-Shield"
		X-Powered-By "Dhimora Echo"
	}

	respond /health 200 {
		body "ok"
	}

	encode zstd gzip

	reverse_proxy {$UPSTREAM_URL:https://dhimora-echo-ecommerce.fly.dev} {
		header_up Host {$UPSTREAM_HOST:dhimora-echo-ecommerce.fly.dev}
		header_up X-Tenant-Domain {host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}

		# Enforce multi-tenant cache isolation by appending Host and tenant domain to Vary
		header_down +Vary "Host, X-Forwarded-Host, X-Tenant-Domain"

		# Strip proxy disclosure header
		header_down -Via

		# Brand every response as part of Dhimora Edge Cloud
		header_down Server "Dhimora-Edge-SIN-01"
		header_down X-Powered-By "Dhimora Echo"
		header_down X-Dhimora-Edge "sin-01"
	}
}
